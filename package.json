{
  "name": "verzel-store-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Teste técnico de QA: validação de cupom de desconto e frete grátis na Verzel Store",
  "scripts": {
    "test": "npm run lint:gherkin && npm run test:ui && npm run test:api && npm run test:ct16",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "test:api": "node scripts/api.mjs",
    "lint:gherkin": "node scripts/validar-gherkin.mjs",
    "evidencias": "cross-env EVIDENCIAS=1 playwright test --project=ui",
    "painel:dados": "python3 scripts/gerar-dados-painel.py",
    "report": "playwright show-report",
    "test:ct16": "playwright test --project=api"
  },
  "author": "Haian Vilas Boas",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "cross-env": "^10.1.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^5.4.0"
  }
}
